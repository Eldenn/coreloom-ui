{
  "name": "@coreloom/ui",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Coreloom UI — shadcn/ui (Radix) components themed with the Coreloom tokens, shipped as a shadcn registry.",
  "scripts": {
    "typecheck": "tsc -b",
    "tokens:sync": "node build/sync-tokens.mjs",
    "tokens:dtcg": "node build/gen-dtcg.mjs",
    "registry:build": "shadcn build -o public/r && node build/registry-guides.mjs && node build/registry-examples.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o public/storybook --quiet",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:a11y": "playwright test a11y",
    "test:visual": "playwright test visual",
    "test:update": "playwright test visual --update-snapshots",
    "artifact:build": "mkdir -p dist/lib && node build/build-artifact.mjs dist/bundle.js && node build/build-libs.mjs dist/lib && tailwindcss -i build/artifact.css -o dist/tailwind.css --minify && cat build/extras.css src/styles/accents.css dist/tailwind.css > dist/bundle.css",
    "starter:sync": "node build/sync-starter.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "llms": "node build/gen-llms.mjs",
    "brand": "node build/gen-brand.mjs",
    "changeset": "changeset",
    "changeset:check": "node build/changelog.mjs --check",
    "version-packages": "changeset version && node build/changelog.mjs",
    "release": "changeset git-tag"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.20",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.56.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^9.14.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint-react/eslint-plugin": "5.28.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "~10.6.2",
    "@storybook/addon-docs": "~10.6.2",
    "@storybook/react-vite": "~10.6.2",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "ai": "7.0.142",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "storybook": "~10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./components/*": "./src/components/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "packageManager": "pnpm@12.13.0"
}
