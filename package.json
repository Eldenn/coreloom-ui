{
  "name": "@coreloom/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coreloom UI — shadcn/ui (Radix) components themed with the Coreloom tokens, shipped as a shadcn registry.",
  "scripts": {
    "typecheck": "tsc -p .",
    "tokens:sync": "node build/sync-tokens.mjs",
    "registry:build": "shadcn build -o public/r",
    "artifact:build": "mkdir -p dist/lib && node build/build-artifact.mjs dist/bundle.js && node build/build-libs.mjs dist/lib && tailwindcss -i build/artifact.css -o dist/tailwind.css --minify && cat build/extras.css dist/tailwind.css > dist/bundle.css"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.56.0",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./components/*": "./src/components/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "packageManager": "pnpm@12.13.0"
}
