{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "coreloom",
  "homepage": "https://github.com/Eldenn/coreloom-ui",
  "items": [
    {
      "name": "theme",
      "type": "registry:item",
      "title": "Coreloom theme",
      "description": "Coreloom UI tokens (dark-first, light via data-theme), the brand fonts (Fontsource) and the Tailwind/shadcn theme layer that maps shadcn color utilities onto the tokens. Import fonts.css, tokens.css and theme.css in your globals.css after tailwindcss.",
      "dependencies": [
        "tw-animate-css",
        "@fontsource-variable/geist",
        "@fontsource-variable/space-grotesk",
        "@fontsource-variable/jetbrains-mono"
      ],
      "files": [
        {
          "path": "src/styles/fonts.css",
          "type": "registry:file",
          "target": "src/styles/coreloom/fonts.css"
        },
        {
          "path": "src/styles/tokens.css",
          "type": "registry:file",
          "target": "src/styles/coreloom/tokens.css"
        },
        {
          "path": "src/styles/theme.css",
          "type": "registry:file",
          "target": "src/styles/coreloom/theme.css"
        }
      ]
    },
    {
