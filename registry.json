{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "coreloom",
  "homepage": "https://github.com/Eldenn/coreloom-ui",
  "items": [
    {
      "name": "theme",
      "type": "registry:item",
      "title": "Coreloom theme",
      "description": "Coreloom UI tokens (dark-first, light via data-theme) and the Tailwind/shadcn theme layer that maps shadcn color utilities onto them. Import both files in your globals.css after tailwindcss.",
      "dependencies": [
        "tw-animate-css"
      ],
      "files": [
        {
          "path": "src/styles/tokens.css",
          "type": "registry:file",
          "target": "src/styles/coreloom/tokens.css"
        },
        {
          "path": "src/styles/theme.css",
          "type": "registry:file",
          "target": "src/styles/coreloom/theme.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn()",
      "description": "Class-name merging helper used by every component.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
